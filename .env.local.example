# Copy this file to .env.local and fill in your real values from:
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here

# Create an Unsplash developer application, then use its Access Key here.
# Keep this server-only variable out of NEXT_PUBLIC_* variables.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Public browser key from your MapTiler Cloud account. Restrict it to your local
# and Vercel domains in MapTiler key settings before deploying.
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key_here
