# Copy this file to .env.local and fill in your real values from:
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=your_project_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_public_key_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Cloudflare Turnstile browser site key. Configure the matching secret only in
# Supabase Auth settings (or SUPABASE_AUTH_CAPTCHA_SECRET for local Supabase).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Create an Unsplash developer application, then use its Access Key here.
# Keep this server-only variable out of NEXT_PUBLIC_* variables.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Public browser key from your MapTiler Cloud account. Restrict it to your local
# and Vercel domains in MapTiler key settings before deploying.
NEXT_PUBLIC_MAPTILER_API_KEY=your_maptiler_api_key_here

# Google Maps Demo Key for prototype-only Routes API access.
# This must stay server-only: do not rename it to NEXT_PUBLIC_.
# It is preferred over OpenRouteService when both keys are configured.
GOOGLE_MAPS_DEMO_API_KEY=your_google_maps_demo_key_here

# The same demo key powers live Google Places suggestions and text search.
# Enable Places API (New) in the Google Maps demo project before using it.

# Create a free OpenRouteService key at https://openrouteservice.org/dev/#/signup.
# Keep this server-only: do not rename it to NEXT_PUBLIC_ and do not place it in client code.
OPENROUTESERVICE_API_KEY=your_openrouteservice_api_key_here

# Gemini powers the grounded TravelAdvisor AI assistant. Keep it server-only.
GEMINI_API_KEY=your_gemini_api_key_here
# Optional. Defaults to gemini-3.1-flash-lite in the application.
GEMINI_MODEL=gemini-3.1-flash-lite
